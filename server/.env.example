# KaamSetu AI Server Environment Variables
PORT=5000

# Gemini AI API Key for Multilingual AI Assistant (Marathi, Hindi, English)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Trust Admin Portal Passcode
ADMIN_PIN=admin123

# MongoDB Connection String:
# Option A: Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/kaamsetu
# Option B: MongoDB Atlas Cloud (Free M0 Cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kaamsetu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kaamsetu

# Optional SMTP Email Service (for real outgoing password reset emails)
# If omitted, KaamSetu runs in dev preview mode and logs reset codes to console & response
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=KaamSetu Security <no-reply@kaamsetu.in>
